<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>BioFlowValidator Report — {{ data.job_id }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #f8fafc; color: #1e293b; }
    .container { max-width: 960px; margin: 2rem auto; padding: 0 1rem; }
    header { background: #0f172a; color: #f8fafc; padding: 1.5rem 2rem; border-radius: .75rem; margin-bottom: 1.5rem; }
    header h1 { font-size: 1.5rem; font-weight: 700; }
    header p { font-size: .875rem; opacity: .75; margin-top: .25rem; }
    .summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
    .stat { border-radius: .5rem; padding: 1rem; text-align: center; }
    .stat-errors { background: #fee2e2; color: #991b1b; }
    .stat-warnings { background: #fef3c7; color: #92400e; }
    .stat-pass { background: #dcfce7; color: #166534; }
    .stat-skip { background: #e0e7ff; color: #3730a3; }
    .stat .num { font-size: 2rem; font-weight: 700; }
    .stat .label { font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; }
    .section-title { font-size: 1.125rem; font-weight: 600; color: #334155; margin: 1.5rem 0 .75rem; border-bottom: 2px solid #e2e8f0; padding-bottom: .5rem; }
    details { background: #fff; border: 1px solid #e2e8f0; border-radius: .5rem; margin-bottom: .5rem; overflow: hidden; }
    details[open] { box-shadow: 0 2px 8px rgba(0,0,0,.06); }
    summary { padding: .875rem 1rem; cursor: pointer; display: flex; align-items: center; gap: .75rem; list-style: none; }
    summary::-webkit-details-marker { display: none; }
    .badge { display: inline-block; padding: .2em .6em; border-radius: 9999px; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
    .badge-ERROR { background: #fee2e2; color: #991b1b; }
    .badge-WARNING { background: #fef3c7; color: #92400e; }
    .badge-INFO { background: #e0f2fe; color: #0369a1; }
    .badge-PASS { background: #dcfce7; color: #166534; }
    .badge-SKIP { background: #e0e7ff; color: #3730a3; }
    .rule-id { font-family: monospace; font-size: .8rem; color: #64748b; min-width: 6rem; }
    .rule-message { flex: 1; font-size: .875rem; }
    .rule-body { padding: .75rem 1rem 1rem; border-top: 1px solid #f1f5f9; }
    .rule-body p { font-size: .875rem; color: #475569; margin-bottom: .5rem; }
    .suggestion { background: #f0fdf4; border-left: 3px solid #22c55e; padding: .5rem .75rem; border-radius: .25rem; font-size: .8rem; color: #15803d; margin-top: .5rem; }
    .affected { margin-top: .5rem; }
    .affected ul { padding-left: 1.25rem; }
    .affected li { font-family: monospace; font-size: .8rem; color: #374151; }
    .meta-table { width: 100%; border-collapse: collapse; font-size: .8rem; }
    .meta-table td, .meta-table th { padding: .4rem .75rem; border: 1px solid #e2e8f0; }
    .meta-table th { background: #f1f5f9; font-weight: 600; }
    footer { text-align: center; font-size: .75rem; color: #94a3b8; margin-top: 2rem; padding-bottom: 2rem; }
  </style>
</head>
<body>
<div class="container">
  <header>
    <h1>🧬 BioFlowValidator Report</h1>
    <p>Job ID: {{ data.job_id }} &nbsp;|&nbsp; Generated: {{ data.timestamp }}</p>
  </header>

  <!-- Summary -->
  <div class="summary">
    <div class="stat stat-errors">
      <div class="num">{{ data.summary.error_count }}</div>
      <div class="label">Errors</div>
    </div>
    <div class="stat stat-warnings">
      <div class="num">{{ data.summary.warning_count }}</div>
      <div class="label">Warnings</div>
    </div>
    <div class="stat stat-pass">
      <div class="num">{{ data.summary.pass_count }}</div>
      <div class="label">Passed</div>
    </div>
    <div class="stat stat-skip">
      <div class="num">{{ data.summary.skip_count }}</div>
      <div class="label">Skipped</div>
    </div>
    <div class="stat" style="background:#f1f5f9;color:#334155;">
      <div class="num">{{ data.summary.total_rules }}</div>
      <div class="label">Total Rules</div>
    </div>
  </div>

  <!-- Files -->
  <div class="section-title">Submitted Files</div>
  <table class="meta-table" style="margin-bottom:1.5rem;">
    <thead><tr><th>Filename</th><th>Size (bytes)</th><th>SHA-256</th></tr></thead>
    <tbody>
    {% for f in data.files %}
      <tr>
        <td>{{ f.filename }}</td>
        <td>{{ "{:,}".format(f.size_bytes) }}</td>
        <td style="font-family:monospace;font-size:.7rem;">{{ f.sha256[:16] }}…</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <!-- Results by category -->
  {% set categories = data.results | map(attribute='category') | unique | list %}
  {% for cat in categories %}
    <div class="section-title">{{ cat | capitalize }} Rules</div>
    {% for r in data.results if r.category == cat %}
    <details {% if r.status == 'FAIL' %}open{% endif %}>
      <summary>
        <span class="rule-id">{{ r.rule_id }}</span>
        <span class="badge badge-{{ r.severity }} {% if r.status == 'PASS' %}badge-PASS{% elif r.status == 'SKIP' %}badge-SKIP{% endif %}">
          {% if r.status == 'PASS' %}PASS{% elif r.status == 'SKIP' %}SKIP{% else %}{{ r.severity }}{% endif %}
        </span>
        <span class="rule-message">{{ r.message }}</span>
      </summary>
      <div class="rule-body">
        {% if r.suggestion %}
        <div class="suggestion">💡 {{ r.suggestion }}</div>
        {% endif %}
        {% if r.affected_items %}
        <div class="affected">
          <p><strong>Affected items:</strong></p>
          <ul>
            {% for item in r.affected_items %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
        {% if r.details %}
        <div class="details-block" style="margin-top: .5rem;">
          <details style="border: 0; background: transparent; padding: 0;">
            <summary style="padding: 0; font-size: .8rem; color: #4f46e5; text-decoration: underline; font-weight: 600;">Show Rule Details</summary>
            <pre style="background: #f1f5f9; padding: .5rem; border-radius: .25rem; font-family: monospace; font-size: .75rem; overflow-x: auto; margin-top: .25rem; white-space: pre-wrap;">{{ r.details | tojson(indent=2) }}</pre>
          </details>
        </div>
        {% endif %}
      </div>
    </details>
    {% endfor %}
  {% endfor %}

  <footer>
    BioFlowValidator &mdash; transparent, rule-based bioinformatics workflow validation.
    Report generated at {{ data.timestamp }}.
  </footer>
</div>
</body>
</html>
